# Copy to deploy/.env and replace the values. Never commit .env.

# --- Production / demo (docker-compose.yml, deploy/README.md) ---
# Public name of the site; Caddy gets its HTTPS certificate. In production PAN__ConnectionStrings__Default (below) points to the
# DigitalOcean managed database (SSL Mode=Require); the demo points it to the postgres container.
PAN_DOMAIN=sgo.example.com

# --- Local Postgres (docker-compose.dev.yml and the demo overlay) ---
POSTGRES_DB=panissimo
POSTGRES_USER=panissimo
POSTGRES_PASSWORD=change-me
# Host ports (change them if taken). The frontend dev proxy expects the API on 8090.
POSTGRES_PORT=5432
API_PORT=8090
# Local backups (backup service in docker-compose.dev.yml): days kept and hours between backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24

# --- API (prefix PAN__ maps to configuration keys) ---
# Development only; docker-compose.yml (production) always sets Production.
ASPNETCORE_ENVIRONMENT=Development
# Postgres connection for `dotnet run` outside docker (production: DigitalOcean Managed with sslmode=require).
# The dev compose builds its own from the POSTGRES_* values.
PAN__ConnectionStrings__Default=Host=localhost;Port=5432;Database=panissimo;Username=panissimo;Password=change-me
# JWT signing key: at least 32 bytes, e.g. `openssl rand -base64 48`
PAN__Jwt__Key=
PAN__Jwt__Issuer=panissimo
PAN__Jwt__Audience=panissimo
# Only used by the first seed
PAN__Seed__AdminEmail=admin@example.com
PAN__Seed__AdminPassword=
# Branch CSV for the seed (codigo,nombre,direccion). Default deploy/seed/locations.csv
# PAN__Seed__LocationsCsv=deploy/seed/locations.csv
# Base catalogs for development and the demo (docker-compose.dev.yml and the demo overlay set it); empty in production.
# PAN__Seed__SampleDataFile=deploy/seed/sample-data.json
# Login attempts per minute per IP. Production: 10 (default). The dev compose uses 60 for the E2E tests.
# PAN__RateLimiting__LoginPermitLimit=10
