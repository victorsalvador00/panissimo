# Copy to deploy/.env and replace the values. Never commit .env.

# --- Local Postgres (docker-compose.dev.yml) ---
POSTGRES_DB=sgo
POSTGRES_USER=sgo
POSTGRES_PASSWORD=change-me
# Host port for the API container (change it if 8080 is taken)
API_PORT=8080
# Local backups (backup service in docker-compose.dev.yml): days kept and hours between backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24

# --- API (prefix SGO__ maps to configuration keys) ---
# Development only; docker-compose.yml (production) always sets Production.
ASPNETCORE_ENVIRONMENT=Development
# Production (DigitalOcean managed Postgres): Host=<host>;Port=25060;Database=sgo;Username=<user>;Password=<password>;SSL Mode=Require
SGO__ConnectionStrings__Default=Host=localhost;Port=5432;Database=sgo;Username=sgo;Password=change-me
# JWT signing key: at least 32 bytes, e.g. `openssl rand -base64 48`
SGO__Jwt__Key=replace-with-a-random-key-of-at-least-32-bytes
SGO__Jwt__Issuer=sgo
SGO__Jwt__Audience=sgo
# Only used by the first seed (B-02)
SGO__Seed__AdminEmail=admin@example.com
SGO__Seed__AdminPassword=ChangeMe12345

# Límite de inicios de sesión por minuto por IP (backend spec §7). Producción: 10 (default).
# El compose de desarrollo usa 60 para las pruebas E2E.
# SGO__RateLimiting__LoginPermitLimit=10

# --- Production web (docker-compose.yml) ---
# Public domain; its DNS A record must point to the Droplet before the first `up` (Let's Encrypt).
SGO_DOMAIN=sgo.example.com
# Contact for the certificate authority (expiry notices)
ACME_EMAIL=ops@example.com
# Angular production build served by Caddy (relative to deploy/). Without it, a maintenance page is shown.
SPA_DIST=../frontend/dist/sgo/browser
# Host ports (keep 80/443 in production)
HTTP_PORT=80
HTTPS_PORT=443
