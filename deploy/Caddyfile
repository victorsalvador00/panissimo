# Production reverse proxy and static files (frontend §10, backend §12).
# PAN_DOMAIN: the public name; Caddy gets and renews its HTTPS certificate.

{$PAN_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health/* {
		reverse_proxy api:8080
	}

	# Without the Angular build (an image built without it, or /srv mounted empty) every page is the maintenance one.
	@nobuild not file {
		root /srv
		try_files /index.html
	}
	handle @nobuild {
		root * /etc/caddy/maintenance
		rewrite * /index.html
		header Cache-Control "no-store"
		file_server {
			status 503
		}
	}

	handle {
		root * /srv
		# Angular names its bundles name-HASH.js / .css: cache them forever.
		@hashed path_regexp -[0-9A-Z]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# index.html and the app routes (paths without an extension) are always revalidated.
		@html not path_regexp \.[0-9A-Za-z]+$
		header @html Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
