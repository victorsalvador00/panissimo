{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Automatic HTTPS for the domain (Let's Encrypt). Frontend and API share the origin: no CORS.
{$SGO_DOMAIN} {
	encode zstd gzip
	import security_headers

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /health/* {
		reverse_proxy api:8080
	}

	# Angular SPA: unknown paths fall back to index.html (client-side routing).
	handle {
		root * /srv
		# Hashed build files are immutable; index.html and client routes must always be revalidated.
		@assets path *.js *.css *.woff2 *.png *.svg *.ico
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path *.js *.css *.woff2 *.png *.svg *.ico
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# No SPA build deployed yet (index.html missing): maintenance page.
	handle_errors 404 {
		import security_headers
		root * /maintenance
		rewrite * /index.html
		file_server {
			status 503
		}
	}
}
